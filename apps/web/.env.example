NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
# SUPABASE_SECRET_KEY= (Server-only — must NEVER be prefixed with NEXT_PUBLIC_)
# UNSPLASH_ACCESS_KEY= (Server-only — must NEVER be prefixed with NEXT_PUBLIC_)
# NEXT_PUBLIC_CANDIDATE_MODE: 'real' | 'demo' | 'mixed' (defaults to 'real')
NEXT_PUBLIC_CANDIDATE_MODE=real


